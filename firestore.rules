rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly(['name','contact','program','message','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.contact is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
